# BoliFlow deployment environment — copy to .env and fill in.

# --- Database -------------------------------------------------------------
# Example: postgresql://boliflow:change-me@db:5432/boliflow
DATABASE_URL=postgresql://boliflow:change-me@db:5432/boliflow
POSTGRES_USER=boliflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=boliflow

# --- Email ----------------------------------------------------------------
# Leave RESEND_API_KEY empty to run in dev mode (emails logged, not sent).
RESEND_API_KEY=
EMAIL_FROM=bookings@client.mv

# --- Branding / domains ----------------------------------------------------
# Base domain for tenant subdomains (e.g. client.oceanatlas.mv)
TENANT_BASE_DOMAIN=oceanatlas.mv

# --- Object storage (Cloudflare R2) ---------------------------------------
# Uploads (images, documents, attachments) go to R2 when all five are set;
# otherwise they fall back to the local filesystem (public/uploads/).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL bound to the bucket (e.g. https://cdn.client.com or https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=

# --- Server ---------------------------------------------------------------
PORT=3000